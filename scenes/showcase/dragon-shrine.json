{
  // The XYZ RGB dragon (250k triangles) in polished gold, at a three-quarter angle so its face and
  // full body show, in front of a red lacquered torii built from boxes. Dusk, low sun from the left.
  "camera": { "look_from": [-0.9, 0.6, 4.6], "look_at": [0.0, 1.3, -0.6], "fov": 46 },
  "settings": { "width": 1920, "aspect_ratio": [16, 9], "samples": 1000, "depth": 30,
                "background": [0.07, 0.08, 0.14] },
  "materials": {
    "gravel":  { "type": "lambertian", "albedo": { "texture": "noise", "colors": [[0.16, 0.15, 0.14], [0.42, 0.4, 0.37]], "scale": 7, "seed": 4 } },
    "stone":   { "type": "lambertian", "albedo": { "texture": "noise", "colors": [[0.32, 0.32, 0.33], [0.55, 0.55, 0.56]], "scale": 2.5, "seed": 9 } },
    "lacquer": { "type": "lambertian", "albedo": [0.72, 0.09, 0.05] },
    "black":   { "type": "lambertian", "albedo": [0.04, 0.04, 0.04] },
    "gold":    { "type": "metal", "albedo": [0.96, 0.74, 0.32], "fuzz": 0.03 },
    "sun":     { "type": "light", "emit": [60, 36, 14] },
    "sky":     { "type": "light", "emit": [0.9, 1.1, 1.6] }
  },
  "objects": [
    { "type": "quad", "corner": [-30, 0, -30], "u": [60, 0, 0], "v": [0, 0, 60], "material": "gravel" },

    // Stepping-stone path from the camera up to the gate.
    { "type": "box", "min": [-0.75, 0, 3.3], "max": [0.65, 0.05, 4.4], "material": "stone" },
    { "type": "box", "min": [-0.7, 0, 2.0], "max": [0.75, 0.05, 3.1], "material": "stone" },
    { "type": "box", "min": [-0.8, 0, 0.7], "max": [0.7, 0.05, 1.8], "material": "stone" },
    { "type": "box", "min": [-0.72, 0, -0.6], "max": [0.78, 0.05, 0.5], "material": "stone" },
    { "type": "box", "min": [-0.75, 0, -1.9], "max": [0.7, 0.05, -0.8], "material": "stone" },
    { "type": "box", "min": [-0.7, 0, -3.2], "max": [0.75, 0.05, -2.1], "material": "stone" },

    // Torii: two pillars on black footings, the lower beam (nuki), the centre post, and the top
    // beams (shimaki under the black-capped kasagi).
    { "type": "box", "min": [-1.86, 0, -2.0], "max": [-1.5, 0.3, -1.64], "material": "black" },
    { "type": "box", "min": [1.5, 0, -2.0], "max": [1.86, 0.3, -1.64], "material": "black" },
    { "type": "box", "min": [-1.81, 0.3, -1.95], "max": [-1.55, 3.05, -1.69], "material": "lacquer" },
    { "type": "box", "min": [1.55, 0.3, -1.95], "max": [1.81, 3.05, -1.69], "material": "lacquer" },
    { "type": "box", "min": [-2.15, 2.4, -1.9], "max": [2.15, 2.6, -1.74], "material": "lacquer" },
    { "type": "box", "min": [-0.1, 2.6, -1.88], "max": [0.1, 3.05, -1.76], "material": "lacquer" },
    { "type": "box", "min": [-2.3, 3.05, -1.95], "max": [2.3, 3.25, -1.69], "material": "lacquer" },
    { "type": "box", "min": [-2.6, 3.25, -2.02], "max": [2.6, 3.45, -1.62], "material": "lacquer" },
    { "type": "box", "min": [-2.65, 3.45, -2.04], "max": [2.65, 3.53, -1.6], "material": "black" },

    {
      "type": "mesh",
      "file": "../../assets/models/xyzrgb_dragon.obj",
      "transform": { "scale": 0.016, "rotate_y": -20, "translate": [-0.25, 0.661, 0.1] },
      "material": "gold"
    },

    // Low warm sun from the left, and a big cool sky panel behind the camera for the gold to
    // reflect, so it shows shape instead of one flat colour.
    { "type": "quad", "corner": [-9, 0.8, -3], "u": [0, 3, 0], "v": [0, 0, 5], "material": "sun" },
    { "type": "quad", "corner": [-6, 0.5, 9], "u": [12, 0, 0], "v": [0, 6, 0], "material": "sky" }
  ]
}